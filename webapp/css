* { box-sizing: border-box; }

/* =========================================================
   TEMA O'ZGARUVCHILARI
   Telegram foydalanuvchisining rejimiga (light/dark) qarab
   app.js "dark" klassini body'ga qo'shadi/olib tashlaydi,
   va rang shu yerdan avtomatik almashadi.
   ========================================================= */
:root {
  --bg: #eef1f7;
  --surface: #ffffff;
  --text: #14161f;
  --text-muted: #7d8494;
  --primary: #4c7cf7;
  --primary-dark: #3866e0;
  --primary-light: #6b93ff;
  --accent: #f0a202;
  --border: #e3e7f0;
  --shadow: rgba(20, 22, 31, 0.08);
  --overlay: rgba(10, 12, 20, 0.45);
  --chip-inactive-bg: #ffffff;
  --chip-inactive-text: #14161f;
}

body.dark {
  --bg: #171b28;
  --surface: #232a3d;
  --text: #f3f5fa;
  --text-muted: #9aa1b5;
  --primary: #4c7cf7;
  --primary-dark: #3866e0;
  --primary-light: #6b93ff;
  --accent: #ffc857;
  --border: #2e3550;
  --shadow: rgba(0, 0, 0, 0.35);
  --overlay: rgba(0, 0, 0, 0.6);
  --chip-inactive-bg: #ffffff;
  --chip-inactive-text: #171b28;
}

body {
  margin: 0;
  font-family: 'Manrope', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  color: var(--text);
  padding-bottom: 100px;
  transition: background 0.2s ease, color 0.2s ease;
}

/* Fon rasmi qo'yilganda - matn har doim o'qilishi uchun
   qorong'ilashtiruvchi qatlam (rejimga qarab tuslanadi) */
body.has-bg {
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  position: relative;
}

body.has-bg::before {
  content: "";
  position: fixed;
  inset: 0;
  background: var(--overlay);
  z-index: 0;
  pointer-events: none;
}

body > * {
  position: relative;
  z-index: 1;
}

/* --- Header --- */
.header {
  position: relative;
  overflow: hidden;
  padding: 24px 16px 30px;
  text-align: center;
  background: linear-gradient(135deg, var(--primary-dark), var(--primary));
  border-radius: 0 0 26px 26px;
  box-shadow: 0 4px 16px var(--shadow);
}

.header-decor {
  position: absolute;
  top: -40px;
  right: -30px;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18), transparent 70%);
}

.header-decor::after {
  content: "";
  position: absolute;
  bottom: -70px;
  left: -40px;
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12), transparent 70%);
}

.header h1 {
  position: relative;
  margin: 0;
  font-size: 21px;
  color: #fff;
  font-weight: 800;
  letter-spacing: -0.2px;
}

.header-sub {
  position: relative;
  margin: 6px 0 0;
  font-size: 12.5px;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

/* --- Aksiya banneri (yuqorida, avtomatik almashinadi) --- */
.promo {
  margin: 14px 12px 0;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 6px 16px var(--shadow);
  position: relative;
}

.promo-track {
  display: flex;
  transition: transform 0.45s ease;
  touch-action: pan-y;
}

.promo-slide {
  flex: 0 0 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  background: var(--surface);
  min-height: 88px;
  cursor: default;
}

.promo-slide img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  border-radius: 12px;
  flex-shrink: 0;
  background: var(--border);
}

.promo-info {
  flex: 1;
  min-width: 0;
}

.promo-label {
  display: inline-block;
  background: var(--accent);
  color: #2a1512;
  font-size: 10.5px;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 6px;
  margin-bottom: 4px;
}

.promo-name {
  font-weight: 700;
  font-size: 13.5px;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.promo-prices {
  margin-top: 3px;
  font-size: 13px;
}

.promo-old {
  color: var(--text-muted);
  text-decoration: line-through;
  margin-right: 6px;
}

.promo-new {
  color: var(--primary);
  font-weight: 800;
}

.promo-dots {
  display: flex;
  justify-content: center;
  gap: 6px;
  padding: 8px 0;
  background: var(--surface);
}

.promo-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--border);
  transition: background 0.2s ease, transform 0.2s ease;
}

.promo-dots span.active {
  background: var(--primary);
  transform: scale(1.3);
}

/* --- Qidiruv paneli: ixcham, bitta pill --- */
.order-search {
  margin: 14px 12px 12px;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 4px;
  background: var(--surface);
  border-radius: 999px;
  padding: 4px 6px 4px 14px;
  box-shadow: 0 4px 14px var(--shadow);
  border: 1px solid var(--border);
}

.search-icon {
  flex-shrink: 0;
  width: 30px;
  height: 30px;
  border: none;
  background: transparent;
  font-size: 15px;
  opacity: 0.7;
  padding: 0;
}

.search-row input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: 10px 8px;
  font-size: 13.5px;
  color: var(--text);
  font-family: inherit;
}

.search-row input::placeholder {
  color: var(--text-muted);
}

.search-result {
  margin-top: 10px;
  padding: 10px 14px;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  font-size: 13px;
  line-height: 1.6;
  color: var(--text);
}

.no-results {
  grid-column: 1 / -1;
  text-align: center;
  padding: 30px 10px;
  color: var(--text-muted);
  font-size: 14px;
}

/* --- Kategoriyalar --- */
.categories {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 4px 12px 14px;
  scrollbar-width: none;
}

.categories::-webkit-scrollbar { display: none; }

.cat-btn {
  flex: 0 0 auto;
  padding: 9px 18px;
  border-radius: 20px;
  border: none;
  background: var(--chip-inactive-bg);
  color: var(--chip-inactive-text);
  font-size: 13.5px;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 1px 4px var(--shadow);
}

.cat-btn.active {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 3px 10px var(--shadow);
}

/* --- Mahsulotlar --- */
.products {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  padding: 0 12px;
}

.product-card {
  position: relative;
  background: var(--surface);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 10px var(--shadow);
  display: flex;
  flex-direction: column;
}

.product-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
}

.product-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: var(--border);
  font-size: 36px;
}

.product-body {
  padding: 10px 10px 12px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.discount-badge {
  position: absolute;
  top: 6px;
  left: 6px;
  background: var(--accent);
  color: #2a1512;
  font-size: 10.5px;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 7px;
}

.product-name {
  font-weight: 700;
  font-size: 14px;
  color: var(--text);
  margin-bottom: 2px;
  line-height: 1.3;
}

.product-desc {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 6px;
  line-height: 1.3;
}

.product-price {
  font-weight: 800;
  font-size: 14px;
  color: var(--primary);
  margin-bottom: 8px;
  margin-top: auto;
}

.product-price .old {
  color: var(--text-muted);
  font-weight: 600;
  font-size: 12px;
  text-decoration: line-through;
  margin-right: 5px;
}

.product-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-btn {
  width: 100%;
  padding: 10px 0;
  border-radius: 10px;
  border: none;
  background: var(--primary);
  color: #fff;
  font-weight: 700;
  font-size: 13px;
}

.add-btn:active {
  filter: brightness(0.92);
}

.qty-btn {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: none;
  background: var(--primary);
  color: #fff;
  font-size: 17px;
  line-height: 1;
  font-weight: 700;
}

.qty-value {
  min-width: 22px;
  text-align: center;
  font-weight: 700;
  color: var(--text);
}

/* --- Savat ro'yxati --- */
.cart-list {
  margin: 12px;
  padding: 12px;
  background: var(--surface);
  border-radius: 16px;
  box-shadow: 0 2px 10px var(--shadow);
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  color: var(--text);
}

.cart-item:last-child {
  border-bottom: none;
}

.cart-item-name {
  flex: 1;
  font-weight: 600;
}

.cart-item-controls {
  display: flex;
  align-items: center;
  gap: 6px;
}

.cart-item-subtotal {
  min-width: 70px;
  text-align: right;
  font-weight: 700;
  color: var(--primary);
}

/* --- Pastki savat paneli --- */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 18px;
  background: var(--primary);
  color: #fff;
  box-shadow: 0 -4px 14px var(--shadow);
  z-index: 2;
}

.cart-bar #cart-summary {
  font-weight: 600;
  font-size: 13px;
}

.cart-bar #checkout-btn {
  padding: 11px 20px;
  border-radius: 10px;
  border: none;
  background: #fff;
  color: var(--primary);
  font-weight: 700;
  font-size: 13px;
}

.hidden {
  display: none !important;
                              }
